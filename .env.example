# Copy to .env and fill in. Every value is optional; without a key the harness runs in mock mode.

# Model provider: anthropic | openai | mock
LLM_PROVIDER=anthropic
# The API auth token for the model (ANTHROPIC_API_KEY / OPENAI_API_KEY are also accepted)
LLM_API_KEY=
# Model for replies (default: claude-sonnet-5-5 for anthropic, gpt-4o for openai)
LLM_MODEL=
# Optional cheaper/faster model for the per-turn extraction step (e.g. claude-haiku-5-5)
LLM_EXTRACTOR_MODEL=
# Optional base URL for OpenAI-compatible servers (Azure, OpenRouter, Ollama, vLLM...) or an Anthropic proxy
LLM_BASE_URL=
# Let the browser UI send its own key per request (header X-LLM-API-Key)
ALLOW_CLIENT_API_KEY=true

# SOP thresholds
SOP_MIN_PII_FACTORS=3
SOP_REP_MIN_PII_FACTORS=2
SOP_MAX_VERIFY_ATTEMPTS=3
SOP_OFF_TOPIC_LIMIT=3
SOP_REFUSAL_LIMIT=3
SOP_CONSENT_MAX_CHECKS=4
# Fixed "today" so the sample claim's appeal deadline (2026-03-18) is still ahead; remove for the real date
SOP_DEMO_DATE=2026-02-10

COMPANY_NAME=Harbor Mutual Insurance
AGENT_NAME=Sam
PORT=8000
